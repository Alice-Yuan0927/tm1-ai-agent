  "cube_roles": {
    "Consol GL Group": {
      "role": "Consolidated group-level financial data with FX translation",
      "best_for": [
        "group P&L reporting",
        "consolidated balance sheet",
        "multi-entity rollup"
      ],
      "avoid_for": [
        "individual journal entry detail",
        "elimination rule setup"
      ]
    },
    "Consol GL Company": {
      "role": "Entity-level financial data in entity currency",
      "best_for": [
        "single entity reporting",
        "entity contribution analysis"
      ],
      "avoid_for": [
        "group consolidated totals",
        "intercompany reconciliation"
      ]
    },
    "Consol GL Group Reporting": {
      "role": "Group financials with reporting perspective and reference period support",
      "best_for": [
        "management reporting",
        "drill-to-entity",
        "multi-period comparison"
      ],
      "avoid_for": [
        "raw data load",
        "elimination rule configuration"
      ]
    },
    "Consol GL Elimination Reconciliation": {
      "role": "Intercompany elimination reconciliation by currency and elimination type",
      "best_for": [
        "ICP matching",
        "elimination variance analysis"
      ],
      "avoid_for": [
        "standalone entity reporting",
        "budget planning"
      ]
    },
    "Consol Definition Group": {
      "role": "Group structure and ownership percentage definitions",
